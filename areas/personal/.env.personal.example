# ═══════════════════════════════════════════════════════════════════
# .env.personal — credentiale pentru skill-urile din areas/personal/
# ═══════════════════════════════════════════════════════════════════
#
# 1. Copiază ca .env.personal: cp .env.personal.example .env.personal
# 2. Completează cu CONTURILE TALE PERSONALE
# 3. NU se commitate (gitignored prin .env*)
#
# Folosit doar de skill-urile din areas/personal/skills/*
# ═══════════════════════════════════════════════════════════════════

# Gmail personal (OAuth)
GMAIL_PERSONAL_TOKEN=...

# Notion personal
NOTION_PERSONAL_TOKEN=secret_...
NOTION_PERSONAL_TASKS_DB=...

# Calendar personal
GOOGLE_CALENDAR_PERSONAL_TOKEN=...

# Locație default (folosit de skill-uri ca my-first-skill)
DEFAULT_CITY=București
DEFAULT_TIMEZONE=Europe/Bucharest
