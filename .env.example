# ═══════════════════════════════════════════════════════════════════
# AI pentru Viața Ta — .env template
# ═══════════════════════════════════════════════════════════════════
#
# 1. Copiază acest fișier ca .env: cp .env.example .env
# 2. Completează cu cheile TALE
# 3. NU urca .env în git (e gitignored)
#
# Generează keys la:
#   Anthropic: https://console.anthropic.com/settings/keys
#   OpenAI:    https://platform.openai.com/api-keys
#   Google:    https://aistudio.google.com/apikey
#
# Setează limit lunar la fiecare ($50 recomandat pentru început).
# ═══════════════════════════════════════════════════════════════════

# ─── REQUIRED (necesar de la M1) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── OPȚIONAL (necesar de la M3-M4) ─────────────────────────────────
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AI...

# ─── Notion (necesar pentru dashboard M5.4) ─────────────────────────
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=...   # din URL-ul database-ului dashboard

# ─── OpenClaw (necesar de la M4) ────────────────────────────────────
# Setări default — ajustează dacă rulezi alt model
OPENCLAW_DEFAULT_MODEL=claude-sonnet-4-6
OPENCLAW_FALLBACK_MODEL=claude-haiku-4-5

# ─── ClawHub credentials (per skill instalat) ───────────────────────
# Aici adaugi token-urile cerute de skills-urile ClawHub pe care le instalezi
# Exemple:
# GMAIL_OAUTH_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# HUBSPOT_PRIVATE_APP_TOKEN=pat-...
# PIPEDRIVE_API_TOKEN=...
